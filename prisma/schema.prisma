datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String?
  education String? @default("MSc Data Science")
  location String? @default("Berlin, Germany")
  targetRoles String[]
  skills String[]
  preferences Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
  interviews Interview[]
  contacts Contact[]
  documents Document[]
  tasks Task[]
  cvVersions CvVersion[]
  coverLetters CoverLetter[]
}

model Application {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  jobTitle String
  jobDescription String? @db.Text
  jobUrl String?
  jobLocation String? @default("Berlin")
  country String? @default("Germany")
  workArrangement String?
  requiredSkills String[]
  preferredSkills String[]
  applicationDate DateTime @default(now())
  status String @default("Saved")
  platform String?
  notes String? @db.Text
  followUpDate DateTime?
  priority String? @default("Medium")
  matchScore Int?
  lastUpdated DateTime @updatedAt

  @@index([userId, status])
}

model Interview {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  company String
  jobTitle String
  date DateTime
  timezone String? @default("Europe/Berlin")
  result String?
}

model Contact {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  company String?
  email String?
  linkedIn String?
}

model Document {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  type String
  fileUrl String
  createdAt DateTime @default(now())
}

model CvVersion {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  content String? @db.Text
  createdAt DateTime @default(now())
}

model CoverLetter {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  content String @db.Text
  createdAt DateTime @default(now())
}

model Task {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String
  type String
  completed Boolean @default(false)
}
